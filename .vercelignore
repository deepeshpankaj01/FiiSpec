# Files the Vercel CLI must not upload. Vercel builds the Next.js app, which
# includes the server API in server/; Firestore rules deploy with the Firebase CLI.

# credentials and local env files: production values are Vercel environment variables
.secrets/
.env
.env*.local

# local tooling, emulator state and logs
.tools/
.tmp/
.emulator-data/
.firebase/
*-debug.log*
npm-debug.log*

# build and test artefacts
.next/
node_modules/
test-results/
playwright-report/
coverage/
*.tsbuildinfo
