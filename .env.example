# FiiSpec configuration. Copy to .env.local for local development; in production
# set the same variables in the Vercel project (Settings → Environment Variables).

# --- Web app (public; Firebase web config values are identifiers, not secrets) ---
# Local development against the Firebase Emulator Suite (default):
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fiispec
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-fiispec.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-fiispec.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Production (values from Firebase console → Project settings → Your apps):
# NEXT_PUBLIC_USE_EMULATORS=false
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=<your-project-id>
# NEXT_PUBLIC_FIREBASE_API_KEY=<web api key>
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_APP_ID=<web app id>
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender id>
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=<reCAPTCHA Enterprise site key for App Check>

# --- Server API (src/app/api; never exposed to the browser) ---
# Service account JSON key (raw or base64) from Firebase console → Project settings →
# Service accounts → Generate new private key. Not needed with the emulators.
# FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional: enables the AI stages. Unset or "not-configured" runs deterministic-only.
# ANTHROPIC_API_KEY=not-configured
# AI_MODEL=claude-opus-5
# Set to true once App Check is configured for the web app.
# ENFORCE_APP_CHECK=false
# Protects /api/cron/sweep; Vercel Cron sends it automatically when set.
# CRON_SECRET=<random string>
