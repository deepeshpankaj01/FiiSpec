# FiiSpec web app configuration. Copy to .env.local for local development.
# Firebase web config values are public identifiers (not secrets).
# Privileged credentials (the AI API key) live only in Cloud Secret Manager.

# --- Local development against the Firebase Emulator Suite (default) ---
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fiispec
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-fiispec.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-fiispec.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FUNCTIONS_REGION=asia-south1

# --- Production (set these in apphosting.yaml / App Hosting environment instead) ---
# NEXT_PUBLIC_USE_EMULATORS=false
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=<your-project-id>
# NEXT_PUBLIC_FIREBASE_API_KEY=<web api key>
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_APP_ID=<web app id>
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender id>
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=<reCAPTCHA Enterprise site key for App Check>
