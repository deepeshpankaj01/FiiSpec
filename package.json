{
  "name": "fiispec",
  "version": "1.0.0",
  "private": true,
  "description": "FiiSpec — AI Standards Intelligence for Procurement (SIH 2026, SIH26108)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run && vitest run --root server --project unit",
    "test:web": "vitest run",
    "test:server": "vitest run --root server --project unit",
    "test:rules": "node scripts/with-java.mjs firebase emulators:exec --only firestore --project demo-fiispec \"vitest run --root server --project rules\"",
    "test:integration": "node scripts/with-java.mjs firebase emulators:exec --only auth,firestore --project demo-fiispec \"vitest run --root server --project integration\"",
    "test:e2e": "playwright test",
    "emulators": "node scripts/with-java.mjs firebase emulators:start --project demo-fiispec --import=.emulator-data --export-on-exit",
    "seed": "tsx server/scripts/seed.ts --emulator",
    "seed:production": "tsx server/scripts/seed.ts --kb-only",
    "grant-admin": "tsx server/scripts/grant-admin.ts",
    "benchmarks": "tsx server/scripts/run-benchmarks.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "docx": "^9.7.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.3",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
